# Payment adapter environment. Copy to /etc/sleephy/pay-adapter.env and fill in.
# This file holds the provider secret; keep it 640 root:sleephy.
#   sudo cp deploy/oracle/pay-adapter.env.example /etc/sleephy/pay-adapter.env

PAY_PROVIDER=yoomoney
PAY_ADAPTER_HOST=127.0.0.1
PAY_ADAPTER_PORT=8791

# The shared token. Must equal SLEEPHY_PAY_ADAPTER_TOKEN on the relay. It is
# the only thing guarding the adapter, which listens on localhost only.
PAY_ADAPTER_TOKEN=CHANGE_ME_shared_token

# YooMoney: your wallet id, the notification secret, and an OAuth token with
# the operation-history scope (needed only for the polling fallback; webhook
# notifications work without it).
YOOMONEY_RECEIVER=410011XXXXXXXXXX
YOOMONEY_SECRET=CHANGE_ME_notify_secret
YOOMONEY_TOKEN=CHANGE_ME_oauth_token

# Where the adapter remembers which payments it has seen.
PAY_STORE=/var/lib/sleephy/pay-store.json
