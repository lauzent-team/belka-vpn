# Relay environment. Copy to /etc/sleephy/relay.env and fill in.
#   sudo cp deploy/oracle/relay.env.example /etc/sleephy/relay.env
#   sudo chown root:sleephy /etc/sleephy/relay.env && sudo chmod 640 /etc/sleephy/relay.env

# Where the relay listens. Caddy sits in front on 443 and proxies here.
SLEEPHY_PORT=12000

# Writable state. The unit grants the service user this directory only.
SLEEPHY_DB=/var/lib/sleephy/sleephy.db
SLEEPHY_DOWNLOADS=/opt/sleephy/dist

# Who may open the admin panel. Comma-separated usernames, lower case.
SLEEPHY_ADMINS=your-admin-username

# Payments. With these set the app hands out a real checkout link; with
# SLEEPHY_PAY_PROVIDER=checkout (the default) the relay serves its own payment
# page and takes no money; SLEEPHY_PAY_PROVIDER=mock settles instantly and is
# meant for tests only.
#
# NOTE: the built-in checkout credits a purchase on a button press and moves no
# money, so it is opt-in — it needs SLEEPHY_PAY_DEMO=1 as well. Without it (and
# with no real provider) purchases are refused rather than credited for free.
SLEEPHY_PAY_PROVIDER=yoomoney
# The adapter's bare host. Do NOT put the token here as well: the relay appends
# /create, /verify and the token itself, so a token in the URL would be doubled
# and every call would 404.
SLEEPHY_PAY_ADAPTER=http://127.0.0.1:8791
# The same value as PAY_ADAPTER_TOKEN on the adapter.
SLEEPHY_PAY_ADAPTER_TOKEN=CHANGE_ME_shared_token
# The public origin, so the post-payment return URL points back at the relay.
SLEEPHY_PAY_PUBLIC_URL=https://relay.example.com
