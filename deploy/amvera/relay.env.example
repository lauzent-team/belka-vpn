# Переменные для релея SleePhy на Amvera.
#
# Куда это вставлять: проект Amvera → раздел «Переменные» → «Добавить переменные
# или секрет». Если у формы есть кнопка загрузки файла — загрузите этот файл,
# формат KEY=VALUE. Строки, начинающиеся с #, — комментарии, их можно не вносить.
#
# ВАЖНО:
#   1. Переменные в Amvera применяются только ПОСЛЕ перезапуска контейнера.
#   2. На этапе СБОРКИ переменные недоступны — они нужны только при ЗАПУСКЕ,
#      а сборка у нас и так идёт по Dockerfile без них. Так что это нормально.
#   3. Значения CHANGE_ME_… замените на свои. Пароли и секреты лучше вносить
#      как «секрет» (в Amvera они хранятся отдельно от обычных переменных).

# ---------------------------------------------------------------------------
# 1. Пути и порт. Уже прописаны в Dockerfile, но здесь указаны явно — так видно
#    весь конфиг в одном месте. Менять не нужно.
# ---------------------------------------------------------------------------
SLEEPHY_DB=/data/sleephy.db
SLEEPHY_DOWNLOADS=/app/dist
PORT=8787

# ---------------------------------------------------------------------------
# 2. Администратор. Кто видит админ-панель (выдаёт Premium, ракеты, смотрит
#    устройства). Это ваш аккаунт, он же владелец. Можно несколько имён через
#    запятую: pidoras,alice
# ---------------------------------------------------------------------------
SLEEPHY_ADMINS=pidoras

# ---------------------------------------------------------------------------
# 3. Репозиторий. Отсюда релей берёт «последний» установщик для страницы
#    скачивания. Обычно менять не нужно.
# ---------------------------------------------------------------------------
SLEEPHY_REPO=lauzent-team/belka-vpn

# ---------------------------------------------------------------------------
# 4. Лимиты аккаунтов на устройство: без Premium — 3, с Premium — 5.
#    Это значения по умолчанию; строки оставлены, чтобы их было видно и можно
#    было поменять. Если менять не хотите — можно удалить, релей возьмёт 3 и 5.
# ---------------------------------------------------------------------------
SLEEPHY_ACCOUNTS_PER_DEVICE=3
SLEEPHY_ACCOUNTS_PER_DEVICE_PREMIUM=5

# ---------------------------------------------------------------------------
# 5. Приветственные ракеты новому аккаунту. 10 — как сейчас. 0 — выключить.
# ---------------------------------------------------------------------------
SLEEPHY_WELCOME_ROCKETS=10

# ---------------------------------------------------------------------------
# 6. ОПЛАТА (главное). Здесь релей говорит с YooMoney напрямую — на Amvera
#    адаптер запустить нельзя, там один процесс.
#
#    Замените три значения:
#      YOOMONEY_RECEIVER        — номер вашего кошелька, вида 41001XXXXXXXXXX
#      YOOMONEY_SECRET          — «секрет» из YooMoney → Настройки → Уведомления
#      SLEEPHY_PAY_ADAPTER_TOKEN — любая длинная случайная строка (она же токен
#                                  в ссылке уведомления). Сгенерировать:
#                                  openssl rand -hex 16
#
#    НЕ добавляйте SLEEPHY_PAY_ADAPTER — с ним релей пойдёт искать адаптер и
#    оплата сломается. И НЕ добавляйте SLEEPHY_PAY_DEMO — это демо-страница,
#    которая зачисляет покупку без денег.
# ---------------------------------------------------------------------------
SLEEPHY_PAY_PROVIDER=yoomoney
YOOMONEY_RECEIVER=CHANGE_ME_wallet_id
YOOMONEY_SECRET=CHANGE_ME_notify_secret
SLEEPHY_PAY_ADAPTER_TOKEN=CHANGE_ME_long_random_token
SLEEPHY_PAY_PUBLIC_URL=https://sleephy-ivanbelka47.msk1.amvera.tech

# ---------------------------------------------------------------------------
# 7. То, чего здесь быть НЕ должно (оставлено закомментированным как памятка):
#    SLEEPHY_PAY_ADAPTER=...   — включает режим внешнего адаптера, на Amvera он
#                                недоступен.
#    SLEEPHY_PAY_DEMO=1        — демо-оплата без списания денег. Только для
#                                показа, на живом сервере включать нельзя.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 8. Необязательное. Значения ниже — те же, что по умолчанию, поэтому их можно
#    не вносить вовсе. Раскомментируйте, только если хотите поменять.
# ---------------------------------------------------------------------------
# Цены в копейках: ракета — 89 коп. (0,89 ₽), Premium — 19900 коп. (199 ₽/мес).
# SLEEPHY_ROCKET_PRICE_KOPECKS=89
# SLEEPHY_PREMIUM_PRICE_KOPECKS=19900

# Ограничения частоты. SLEEPHY_RATE_LIMIT=off выключает лимиты целиком
# (только для тестов, на живом сервере не ставьте).
# SLEEPHY_RATE_REGISTER=30
# SLEEPHY_RATE_LOGIN=10
# SLEEPHY_RATE_SEND=60
# SLEEPHY_RATE_SEARCH=60
# SLEEPHY_RATE_PAY=20

# Необязательно: OAuth-токен YooMoney. Если уведомление не дошло, релей сможет
# сам спросить историю операций по метке платежа.
# YOOMONEY_TOKEN=
